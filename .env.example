# Development Environment Configuration
# Copy this to .env.local or .env for development

# Server
NODE_ENV=development
PORT=5000
HOST=localhost

# Database
MONGODB_URI=mongodb://localhost:27017/karankar_db
DB_NAME=karankar_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Email Service (Ethereal for development)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_ethereal_email@ethereal.email
EMAIL_PASSWORD=your_ethereal_password
EMAIL_FROM=noreply@karankarsons.com

# Razorpay Keys (Test Keys for Development)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# Upload Configuration
MAX_FILE_SIZE=10485760
UPLOADS_DIR=backend/uploads

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
MAX_BACKUP_AGE_DAYS=30

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5000

# Session
SESSION_SECRET=your_session_secret_key
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Rate Limiting
RATE_LIMIT_WINDOW_MS=15000000
RATE_LIMIT_MAX_REQUESTS=100

# API Configuration
API_PREFIX=/api
API_TIMEOUT=30000

# Frontend
FRONTEND_URL=http://localhost

# Analytics (Optional)
ENABLE_ANALYTICS=true
