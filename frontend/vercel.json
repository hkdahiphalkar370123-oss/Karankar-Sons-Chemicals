{
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/products", "destination": "/products.html" },
    { "source": "/product-detail", "destination": "/product-detail.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/service-booking", "destination": "/service-booking.html" },
    { "source": "/order-detail", "destination": "/order-detail.html" },
    { "source": "/admin", "destination": "/admin-dashboard.html" },
    { "source": "/admin-dashboard", "destination": "/admin-dashboard.html" },
    { "source": "/admin/:path*", "destination": "/admin-dashboard.html" },
    { "source": "/dashboard", "destination": "/user-dashboard.html" },
    { "source": "/dashboard/:path*", "destination": "/user-dashboard.html" },
    { "source": "/user-dashboard", "destination": "/user-dashboard.html" },
    { "source": "/orders", "destination": "/user-dashboard.html" },
    { "source": "/profile", "destination": "/user-dashboard.html" },
    { "source": "/cart", "destination": "/user-dashboard.html" }
  ],
  "trailingSlash": false
}
